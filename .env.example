# ==============================================================================
# ZENBET - VARIABLES DE ENTORNO LOCALES Y DOCKER (.NET 10 + PostgreSQL)
# Copia este archivo a `.env` en la raíz antes de ejecutar Docker Compose.
#
# IMPORTANTE: los valores de abajo son EJEMPLOS para desarrollo local, no
# secretos seguros. docker-compose.yml ya no tiene fallback para
# POSTGRES_PASSWORD / JWT_SIGNING_KEY / SETTLEMENT_API_KEY: si no los
# defines en tu .env, `docker compose up` falla con un mensaje claro en vez
# de arrancar silenciosamente con un secreto conocido. Antes de desplegar en
# cualquier entorno accesible desde internet, genera valores nuevos y
# aleatorios para los tres (por ejemplo con `openssl rand -hex 32`).
# ==============================================================================

# Credenciales del contenedor de PostgreSQL
POSTGRES_DB=zenbet_events_markets
POSTGRES_USER=zenbet
POSTGRES_PASSWORD=zenbet_dev_password_2026
POSTGRES_PORT=5432

# Cadenas de conexión para Entity Framework Core (.NET 10 Clean Architecture)
# 1. Para ejecutar localmente en la máquina host (dotnet run):
ConnectionStrings__EventsMarkets="Host=localhost;Port=5432;Database=zenbet_events_markets;Username=zenbet;Password=zenbet_dev_password_2026"

# 2. Para ejecutar dentro del contenedor o red Docker:
ConnectionStrings__EventsMarkets_Docker="Host=postgres;Port=5432;Database=zenbet_events_markets;Username=zenbet;Password=zenbet_dev_password_2026"

# Configuración de ejecución ASP.NET Core & Workers
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000

# Secretos Criptográficos (Firma JWT HS256 >= 32 caracteres)
JWT_SIGNING_KEY=e8e72c60620f262e75cdacfa004fa1cc59b4ff14435a225c54deff7a6c676359

# Secreto HMAC de la pasarela RGS (>= 32 caracteres). Fuera de Development debe ser propio.
RGS_SHARED_SECRET=zenbet-rgs-hmac-sha256-shared-secret-key-2026

# Primer administrador. La liquidación de mercados, el ajuste de cuotas y la
# aprobación de depósitos exigen una sesión con rol admin (ya no existe la clave
# compartida X-Settlement-Key). Se crea solo si aún no existe ningún admin.
# Contraseña de al menos 14 caracteres; retírala del entorno tras el primer arranque.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Configuración de Frontend y Reverse Proxy Nginx
# Datos DEMO (cartelera UFC de referencia y partidos de fútbol ficticios con marcador y minuto simulados).
# Apagados por defecto: una plataforma con dinero real no debe mostrar eventos que no existen.
# Actívalos solo para una demostración local.
SEED_UFC_DEMO=false
SEED_FOOTBALL_DEMO=false

FRONTEND_PORT=80
VITE_API_URL=/api/v1
VITE_AUTH_URL=/api
VITE_HUB_URL=/odds-hub
VITE_FIGHT_HUB_URL=/fight-hub
