# Copy this file to .env and replace every placeholder before running Docker Compose.
# Never commit the resulting .env file.

# PostgreSQL
POSTGRES_DB=zenbet_events_markets
POSTGRES_USER=zenbet
POSTGRES_PASSWORD=change-me-postgres-password

# Backend secrets
# Auth:SigningKey requires at least 32 characters.
JWT_SIGNING_KEY=change-me-with-at-least-32-characters
SETTLEMENT_API_KEY=change-me-settlement-key

# Frontend build-time URLs. They are relative so Nginx proxies same-origin
# requests to the backend and CORS is not needed in production.
VITE_API_URL=/api/v1
VITE_AUTH_URL=/api
VITE_HUB_URL=/odds-hub
