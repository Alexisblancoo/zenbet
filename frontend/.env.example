# Zenbet / Frontend (Vite)
# URL base de la Web API .NET 10. No incluyas la barra final.
VITE_API_URL=http://localhost:5000/api/v1

# Compatibilidad con el nombre anterior (opcional).
# VITE_API_BASE_URL=http://localhost:5000/api

# Override opcional SOLO para auth (login/register). Úsalo mientras la Web API
# nueva no exponga /api/v1/auth/*, apuntando a la API legacy:
# VITE_AUTH_URL=http://localhost:5000/api

# Override opcional del hub SignalR. Por defecto se deriva del origen de
# VITE_API_URL + /odds-hub (ej. http://localhost:5000/odds-hub).
# VITE_HUB_URL=http://localhost:5000/odds-hub
