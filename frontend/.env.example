# Zenbet / Frontend (Vite) — ejemplo de configuración.
# Copia este archivo a `.env.development` y ajusta lo que necesites.
# URL base de la Web API .NET 10. No incluyas la barra final.
VITE_API_URL=http://localhost:5080/api/v1

# Compatibilidad con el nombre anterior (opcional).
# VITE_API_BASE_URL=http://localhost:5080/api

# Override de auth (login/register). DEJALO COMENTADO a menos que auth viva
# fuera de /api/v1: por defecto authService usa VITE_API_URL + /auth/*.
# VITE_AUTH_URL=http://localhost:5080/api

# Override opcional de los hubs SignalR. Por defecto se derivan del origen de
# VITE_API_URL (ej. http://localhost:5080/odds-hub).
# VITE_HUB_URL=http://localhost:5080/odds-hub
# VITE_FIGHT_HUB_URL=http://localhost:5080/fight-hub
# VITE_FOOTBALL_HUB_URL=http://localhost:5080/football-hub

# SOLO DESARROLLO. El login legacy no entrega walletId, pero POST /api/v1/bets
# exige el GUID de una billetera existente. Definelo aquí para probar el flujo
# real (nunca lo uses en producción ni con una billetera ajena).
# VITE_DEV_WALLET_ID=00000000-0000-0000-0000-000000000000
